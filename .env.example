# ── Discord ───────────────────────────────────────────────────────────────────
# Token do bot (Discord Developer Portal → Bot → Reset Token).
DISCORD_TOKEN=coloque_o_token_do_bot_aqui
# Opcional: sincroniza os comandos slash só neste servidor (útil em desenvolvimento).
# DEV_GUILD_ID=123456789012345678

# ── Banco de dados ────────────────────────────────────────────────────────────
# Com Docker Compose o host é "postgres". Rodando bot/dashboard fora do Docker
# (uv run ...), use POSTGRES_HOST=localhost.
# POSTGRES_HOST tem prioridade sobre DATABASE_URL.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bate_ponto
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
# Alternativa: uma URL completa (deixe POSTGRES_HOST vazio/removido para usá-la).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bate_ponto

LOG_LEVEL=INFO

# ── Dashboard web ─────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false
# Gere com: make secret   (openssl rand -hex 32)
DASHBOARD_SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Login com Discord (obrigatório): cada pessoa entra com a própria conta e vê só os
# servidores em que tem "Gerenciar Servidor" (e onde o bot já foi configurado).
# Developer Portal → OAuth2: copie Client ID / Client Secret e cadastre o Redirect
# <URL do dashboard>/auth/discord/callback (o mesmo valor de DISCORD_REDIRECT_URI).
# DISCORD_CLIENT_ID=123456789012345678
# DISCORD_CLIENT_SECRET=cole-aqui-o-client-secret
# DISCORD_REDIRECT_URI=https://ponto.exemplo.com/auth/discord/callback
# Endereço público do dashboard, enviado na mensagem de boas-vindas do bot.
# DASHBOARD_URL=https://ponto.exemplo.com
# IDs de usuário do Discord (separados por vírgula) que veem todos os servidores.
# DASHBOARD_ADMIN_DISCORD_IDS=123456789012345678

# true exige HTTPS; use false somente em desenvolvimento local via HTTP.
DASHBOARD_SECURE_COOKIES=true
DASHBOARD_SESSION_HOURS=8
# true quando o dashboard roda atrás de um proxy reverso (Nginx, Caddy, Cloudflare...).
DASHBOARD_PROXY_FIX=true
